  "food": {
    "summary": "瑞亚维德酒店所在地区的传统饮食有清晰的地方性。泰国南部菜受海洋、马来半岛和热带香料影响，味道通常比中部更直接：酸、辣、姜黄、椰奶与大量新鲜海产并行。雨林内陆又会加入竹笋、野菜、河鱼和简单炭烤。",
    "setting": "洞穴餐厅、海滩餐厅与正式泰餐厅并存，环境戏剧性强，但需要提前确认营业与着装。",
    "highlights": [
      {
        "name": "Gaeng Som",
        "description": "以罗望子和辣椒形成酸辣汤底，常煮鱼、虾或蔬菜，是南泰最鲜明的味型。"
      },
      {
        "name": "Khao Yam",
        "description": "米饭拌香草、豆芽、椰丝和咸鲜酱汁，清爽且能体现南部植物香气。"
      },
      {
        "name": "姜黄海鲜",
        "description": "姜黄、蒜和胡椒常用于鱼虾炖煮或煎炒，香气浓而不依赖甜味。"
      },
      {
        "name": "林地家常菜",
        "description": "竹笋、蕨菜、香蕉花和河鱼会随季节进入雨林旅馆餐桌。"
      }
    ],
    "caveat": "洞穴餐厅并非每天或全天开放，且酒店餐饮整体价格较高。",
